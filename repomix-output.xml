// Angoli arrotondati "a ritaglio" su immagini gia' disegnate (copertine, radar).
void roundCorners(int x, int y, int w, int h, int r, uint16_t outside)
{
  for (int i = 0; i < r; i++)
  {
    float dy = r - i - 0.5f;
    int inset = r - (int)floorf(sqrtf((float)r * r - dy * dy) + 0.5f);
    if (inset <= 0)
      continue;
    tft.fillRect(x, y + i, inset, 1, outside);
    tft.fillRect(x + w - inset, y + i, inset, 1, outside);
    tft.fillRect(x, y + h - 1 - i, inset, 1, outside);
    tft.fillRect(x + w - inset, y + h - 1 - i, inset, 1, outside);
  }
}

