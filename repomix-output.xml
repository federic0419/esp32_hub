void getTinyTime(char *b, size_t n)
{
  struct tm ti;
  if (getLocalTime(&ti, 0))
    snprintf(b, n, "%02d:%02d", ti.tm_hour, ti.tm_min);
  else
    snprintf(b, n, "--:--");
}

