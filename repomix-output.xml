// Rettangolo arrotondato con bordi anti-aliasing (bg = colore sotto).
void rrect(int x, int y, int w, int h, int r, uint16_t c, uint16_t bg = C_BG)
{
  if (w <= 0 || h <= 0)
    return;
  if (r > w / 2)
    r = w / 2;
  if (r > h / 2)
    r = h / 2;
  if (r < 1)
    tft.fillRect(x, y, w, h, c);
  else
    tft.fillSmoothRoundRect(x, y, w, h, r, c, bg);
}

// Pannello piatto con bordo sottile.
void panel(int x, int y, int w, int h, int r = 9, uint16_t fill = C_PANEL, uint16_t border = C_LINE, uint16_t bg = C_BG)
{
  rrect(x, y, w, h, r, border, bg);
  rrect(x + 1, y + 1, w - 2, h - 2, r - 1, fill, border);
}

void disc(int cx, int cy, int r, uint16_t c, uint16_t bg = C_BG)
