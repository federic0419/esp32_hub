void maybeFetchWeather()
{
  if (curPage == 0 || curPage == 1)
    return;
  uint32_t now = millis();
  bool stale = weatherOk && (now - weatherTs > WEATHER_REFRESH_MS);
  bool retry = !weatherOk && (weatherTry == 0 || now - weatherTry > 30000);
  if (stale || retry)
  {
    if (fetchWeather())
      switchPage(curPage);
  }
}

// Nessuna sospensione automatica del display.
// Se Spotify e' in riproduzione, dopo 30 s senza touch puo' entrare la modalita Ambient.

// ########==================== AMBIENT MODE / LED RGB ====================########
// Il LED RGB del CYD viene usato solo in due situazioni:
//   1) durante il boot, seguendo i colori dell'animazione;
//   2) in Spotify Ambient Mode, con un verde "breathing".
// Fuori da questi stati il LED resta spento.
//
// Il LED onboard e' attivo basso. Usiamo il PWM hardware dell'ESP32
// per ottenere variazioni morbide di luminosita'.
constexpr int RGB_PWM_CH_R = 0;
constexpr int RGB_PWM_CH_G = 1;
constexpr int RGB_PWM_CH_B = 2;
constexpr int RGB_PWM_FREQ = 5000;
constexpr int RGB_PWM_BITS = 8;

void writeRgbPwm(uint8_t red, uint8_t green, uint8_t blue)
{
  // Active-low: 255 significa spento sul pin, 0 significa piena luminosita'.
  ledcWrite(RGB_PWM_CH_R, 255 - red);
  ledcWrite(RGB_PWM_CH_G, 255 - green);
  ledcWrite(RGB_PWM_CH_B, 255 - blue);
}

void setRgbLed(uint8_t red, uint8_t green, uint8_t blue)
{
  if (!rgbLedEnabled)
  {
    writeRgbPwm(0, 0, 0);
    return;
  }

  writeRgbPwm(red, green, blue);
}

void initRgbLed()
{
  ledcSetup(RGB_PWM_CH_R, RGB_PWM_FREQ, RGB_PWM_BITS);
  ledcSetup(RGB_PWM_CH_G, RGB_PWM_FREQ, RGB_PWM_BITS);
  ledcSetup(RGB_PWM_CH_B, RGB_PWM_FREQ, RGB_PWM_BITS);

  ledcAttachPin(RGB_LED_R, RGB_PWM_CH_R);
  ledcAttachPin(RGB_LED_G, RGB_PWM_CH_G);
  ledcAttachPin(RGB_LED_B, RGB_PWM_CH_B);

  writeRgbPwm(0, 0, 0);
}

void setBootRgbLed(int active)
{
  if (!rgbLedEnabled)
  {
    writeRgbPwm(0, 0, 0);
    return;
  }

  switch (active & 3)
  {
  case 0:
    setRgbLed(30, 220, 60); // verde
    break;
  case 1:
    setRgbLed(64, 200, 255); // ciano
    break;
  case 2:
    setRgbLed(255, 210, 0); // ambra
    break;
  default:
    setRgbLed(255, 25, 25); // rosso
    break;
  }
}

void updateRgbLed()
{
  if (!rgbLedEnabled)
  {
    writeRgbPwm(0, 0, 0);
    return;
  }

  if (T.playing)
  {
    // Verde "breathing": circa 12% -> 70% -> 12%.
    float wave = (sinf((float)millis() / 850.0f) + 1.0f) * 0.5f;
    uint8_t green = (uint8_t)(30.0f + wave * 150.0f);
    setRgbLed(0, green, 0);
    return;
  }

  // UI normale: LED spento.
  writeRgbPwm(0, 0, 0);
}

void maybePollSpotifyBackground()
{
  // Nella pagina Player il poll e' gia' eseguito da spLoop().
  if (!spotifyAmbientMode && curPage == 1)
    return;

  if (millis() >= nextPoll)
    spotifyPoll();
}

void maybeEnterSpotifyAmbientMode()
{
  if (!ambientSpotifyEnabled || spotifyAmbientMode)
    return;

  if (!T.playing || !T.key.length())
    return;

  if (millis() - lastUserInteractionMs >= SPOTIFY_AMBIENT_DELAY_MS)
    enterSpotifyAmbientMode();
}

// ########==================== TOUCH / GESTURE ====================########
bool tsDown = false;
uint32_t tsLastSeen = 0, tsStartT = 0;
int sx, sy, lx, ly;

void handleTouch()
{
#ifdef WOKWI
  // Diagnostica Wokwi: ci serve capire se il click arriva davvero
  // all'XPT2046 simulato prima di modificare ancora la navigazione.
  static uint32_t lastTouchDebug = 0;

  bool irqActive = (digitalRead(TOUCH_IRQ) == LOW);
  bool touchedNow = ts.touched();
  bool now = touchedNow;

  uint32_t dbgNow = millis();
  if (dbgNow - lastTouchDebug >= 500)
  {
    Serial.printf("[WOKWI TOUCH] IRQ=%d touched=%d\n",
                  irqActive ? 1 : 0,
                  touchedNow ? 1 : 0);
    lastTouchDebug = dbgNow;
  }
#else
  bool now = ts.tirqTouched() && ts.touched();
#endif

  uint32_t ms = millis();

  if (now)
  {
    TS_Point p = ts.getPoint();

#ifdef WOKWI
    Serial.printf("[WOKWI TOUCH] RAW x=%d y=%d z=%d\n", p.x, p.y, p.z);
#endif

    int x = calibratedTouchX(p.x);
    int y = calibratedTouchY(p.y);

#ifdef WOKWI
    Serial.printf("[WOKWI TOUCH] MAP x=%d y=%d\n", x, y);
#endif
    if (!tsDown)
    {
      lastUserInteractionMs = ms;
      tsDown = true;
      sx = x;
      sy = y;
      tsStartT = ms;
    }
    lx = x;
    ly = y;
    tsLastSeen = ms;
  }
  else if (tsDown && ms - tsLastSeen > 60)
  {
    tsDown = false;
    int dx = lx - sx, dy = ly - sy;
    bool tap = abs(dx) < 20 && abs(dy) < 20 && ms - tsStartT < 800;

    // In Ambient Mode qualsiasi gesto/tap serve solo a tornare alla UI normale.
    if (spotifyAmbientMode)
    {
      exitSpotifyAmbientMode();
      return;
    }

    if (tap && ly >= NAV_Y - 2)
    {
      // Tab bar: la colonna toccata decide la pagina.
      int best = constrain(lx * NUM_PAGES / 320, 0, NUM_PAGES - 1);
      if (best != curPage)
        switchPage(best);
    }
    else if (curPage == 0 &&
             spotifyLibraryView == LIB_QUEUE &&
             abs(dy) > 24 &&
             abs(dy) > abs(dx))
    {
      // Coda Spotify: swipe verticale continuo per righe, non a pagine.
      // Dito verso l'alto -> mostra elementi successivi.
      int visible = min(QUEUE_VISIBLE_ROWS, (int)spotifyQueue.size());
      int maxFirst = max(0, (int)spotifyQueue.size() - visible);
      int rows = max(1, abs(dy) / (Q_H + Q_GY));

      if (dy < 0)
        queueScrollRow = min(maxFirst, queueScrollRow + rows);
      else
        queueScrollRow = max(0, queueScrollRow - rows);

      drawPlaylistPage();
    }
    else if (abs(dx) > 50 && abs(dx) > abs(dy) * 2)
    {
      switchPage(curPage + (dx < 0 ? 1 : -1));
    }
    else if (tap)
    {
      pages[curPage].tap(lx, ly);
    }
  }
}

// ########==================== BOOT ANIMATION ====================########

static const uint16_t BOOT_DOTS[4] = {C_GREEN, C_CYAN, C_AMBER, C_RED};

void drawBootLogo(float phase)
{
  // marchio: quattro nodi (le sezioni dell'hub) attorno a un centro
  int active = ((int)(phase * 2.5f)) % 4;
  setBootRgbLed(active);
  const int cx = 160, cy = 84;
  panel(cx - 34, cy - 34, 68, 68, 18, C_PANEL, C_LINE);
  static const int8_t ox[4] = {-15, 15, 15, -15}, oy[4] = {-15, -15, 15, 15};
  for (int i = 0; i < 4; i++)
  {
    uint16_t c = (i == active) ? BOOT_DOTS[i] : mix565(C_PANEL, BOOT_DOTS[i], 105);
    disc(cx + ox[i], cy + oy[i], (i == active) ? 8 : 7, c, C_PANEL);
  }
  disc(cx, cy, 4, C_FG, C_PANEL);
}

void drawBootProgress(float progress)
{
  progress = constrain(progress, 0.0f, 1.0f);
  constexpr int X = 80, Y = 196, W = 160, H = 4;
  rrect(X, Y, W, H, 2, C_TRACK);
  int fillW = (int)(W * progress);
  if (fillW > 0)
    rrect(X, Y, max(fillW, H), H, 2, C_GREEN, C_TRACK);
}

void drawBootFrame(
    float phase,
    float progress,
    const char *status = nullptr)
{
  if (!bootStatic)
  {
    tft.fillScreen(C_BG);
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(C_FG, C_BG);
    tft.drawString("CYD HUB", 160, 146, 4);
    tft.setTextColor(C_FAINT, C_BG);
    tft.drawString("v7", 160, 166, 1);
    bootStatic = true;
  }
  drawBootLogo(phase);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(C_DIM, C_BG);
  tft.setTextPadding(200);
  tft.drawString(status && strlen(status) ? status : "avvio...", 160, 182, 2);
  tft.setTextPadding(0);
  drawBootProgress(progress);
  tft.setTextDatum(TL_DATUM);
}

void bootIntro()
{
  bootStatic = false;
  for (int i = 0; i < 8; i++)
  {
    drawBootFrame(i * 0.4f, 0.05f + i * 0.02f, "avvio...");
    delay(90);
  }
}
