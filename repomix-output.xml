// Rettangolo arrotondato con bordi anti-aliasing (bg = colore sotto).
void rrect(int x, int y, int w, int h, int r, uint16_t c, uint16_t bg = C_BG)
{
  if (w <= 0 || h <= 0)
    return;
  if (r > w / 2)
    r = w / 2;
  if (r > h / 2)
    r = h / 2;
  if (r < 1)
    tft.fillRect(x, y, w, h, c);
  else
    tft.fillSmoothRoundRect(x, y, w, h, r, c, bg);
}

