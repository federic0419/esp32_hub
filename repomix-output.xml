void spLoop()
{
  static uint32_t lastEq = 0;
  uint32_t now = millis();
  if (statusMsg.length() && now > statusUntil)
  {
    statusMsg = "";
    needText = true;
  }
  if (now >= nextPoll)
    spotifyPoll();
  if (needText)
  {
    drawTrackText();
    needText = false;
  }
  if (needCtl)
  {
    drawControls();
    needCtl = false;
  }
  if (needArt)
  {
    needArt = false;
    drawArtPlaceholder();
    if (T.artUrl.length())
    {
      fetchArt(T.artUrl);
      finishArt();
    }
  }
  if (now - lastEq >= 220)
  {
    drawEq(T.playing);
    lastEq = now;
  }
  if (now - lastProg >= 500 || progDirty)
  {
    drawProgress();
    lastProg = now;
  }
}

void spTap(int x, int y)
{
  // Pulsante CODA nella top bar.
  if (x >= 184 && x <= 236 && y <= 28)
  {
    openSpotifyQueue();
    return;
  }

  if (y < 140 || y >= NAV_Y - 26 || x < 172)
    return;
  if (x < 216)
    spotifyCommand("POST", "/v1/me/player/previous");
  else if (x < 266)
  {
    T.progress = progressNow();
    T.stamp = millis();
    T.playing = !T.playing;
    drawControls();
    needText = true;
    spotifyCommand("PUT", T.playing ? "/v1/me/player/play" : "/v1/me/player/pause");
  }
  else
    spotifyCommand("POST", "/v1/me/player/next");
}

