void fetchArt(const String &url)
{
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.useHTTP10(true);
  http.setTimeout(8000);
  if (!http.begin(client, url))
    return;
  int code = http.GET();
  int size = http.getSize();
  if (code == 200 && size > 0 && size < 90000)
  {
    uint8_t *buf = (uint8_t *)malloc(size);
    if (buf)
    {
      WiFiClient *s = http.getStreamPtr();
      int got = 0;
      uint32_t t0 = millis();
      while (got < size && millis() - t0 < 8000)
      {
        int av = s->available();
        if (av > 0)
          got += s->readBytes(buf + got, min(av, size - got));
        else if (!s->connected())
          break;
        else
          delay(1);
      }
      if (got == size && jpeg.openRAM(buf, size, jpegDraw))
      {
        int w = jpeg.getWidth();
        int sc = (w >= 500) ? JPEG_SCALE_QUARTER : (w >= 250) ? JPEG_SCALE_HALF
                                                              : 0;
        jpeg.decode(0, 0, sc);
        jpeg.close();
      }
      free(buf);
    }
  }
  http.end();
}

void spotifyPoll()
{
  JsonDocument doc;
  int code = spotifyCall("GET", "/v1/me/player/currently-playing?additional_types=episode", &doc, &fCur);
  uint32_t now = millis();
  if (code == 200 && !doc["item"].isNull())
  {
    JsonObject it = doc["item"];
    String id = it["id"] | "";
    String name = fold(it["name"] | "");
    String key = id + "|" + name;
    String artist = fold(it["artists"][0]["name"] | (it["show"]["name"] | ""));
    T.playing = doc["is_playing"] | false;
    T.progress = doc["progress_ms"] | 0;
    T.duration = it["duration_ms"] | 0;
    T.stamp = now;
    if (key != T.key)
    {
      T.key = key;
      T.title = name;
      T.artist = artist;
      JsonArray imgs = it["album"]["images"].as<JsonArray>();
      if (imgs.isNull())
        imgs = it["images"].as<JsonArray>();
      int best = 100000;
      T.artUrl = "";
      for (JsonObject im : imgs)
      {
        int d = abs((int)(im["width"] | 0) - 300);
        if (d < best)
        {
          best = d;
          T.artUrl = im["url"] | "";
        }
      }
      needText = needArt = progDirty = true;
    }
    if (T.playing != drawnPlaying)
      needCtl = true;
    nextPoll = now + SPOTIFY_POLL_MS;
  }
  else if (code == 204 || code == 200)
  {
    String nt = (code == 200) ? "Pubblicita" : "";
    if (T.key.length() || T.title != nt)
    {
      T.key = "";
      T.title = nt;
      T.artist = "";
      T.artUrl = "";
      T.playing = false;
      T.progress = 0;
      T.duration = 0;
      needText = needArt = needCtl = progDirty = true;
    }
    nextPoll = now + 5000;
  }
  else if (code == 429)
  {
    nextPoll = now + 15000;
  }
  else
  {
    nextPoll = now + 6000;
  }
}

void setStatus(const char *m)
{
  statusMsg = m;
  statusUntil = millis() + 4000;
  needText = true;
}

void spotifyCommand(const char *method, const char *path)
{
  int code = spotifyCall(method, path);
  if (code == 404)
    setStatus("Nessun dispositivo");
  else if (code == 403)
    setStatus("Serve Spotify Premium");
  else if (code < 0)
    setStatus("Errore di rete");
  nextPoll = millis() + 800;
}

void spEnter()
{
  tft.fillScreen(C_BG);
  drawTopBar("SPOTIFY", C_GREEN);
  needText = needArt = needCtl = progDirty = true;
  nextPoll = 0;
  lastProg = 0;
}

void spLoop()
{
  static uint32_t lastEq = 0;
  uint32_t now = millis();
  if (statusMsg.length() && now > statusUntil)
  {
    statusMsg = "";
    needText = true;
  }
  if (now >= nextPoll)
    spotifyPoll();
  if (needText)
  {
    drawTrackText();
    needText = false;
  }
  if (needCtl)
  {
    drawControls();
    needCtl = false;
  }
  if (needArt)
  {
    needArt = false;
    drawArtPlaceholder();
    if (T.artUrl.length())
    {
      fetchArt(T.artUrl);
      finishArt();
    }
  }
  if (now - lastEq >= 220)
  {
    drawEq(T.playing);
    lastEq = now;
  }
  if (now - lastProg >= 500 || progDirty)
  {
    drawProgress();
    lastProg = now;
  }
}

void spTap(int x, int y)
{
  if (y < 140 || y >= NAV_Y - 26 || x < 172)
    return;
  if (x < 216)
    spotifyCommand("POST", "/v1/me/player/previous");
  else if (x < 266)
  {
    T.progress = progressNow();
    T.stamp = millis();
    T.playing = !T.playing;
    drawControls();
    needText = true;
    spotifyCommand("PUT", T.playing ? "/v1/me/player/play" : "/v1/me/player/pause");
  }
  else
    spotifyCommand("POST", "/v1/me/player/next");
}

// ===================== Spotify: playlist =====================
struct PlaylistItem
{
  String name;
  String uri;
};

std::vector<PlaylistItem> spotifyPlaylists;
bool playlistsLoaded = false;
bool playlistsLoading = false;
String playlistsStatus;
int playlistPage = 0;
constexpr int PLAYLIST_COLS = 2;
constexpr int PLAYLIST_ROWS = 3;
constexpr int PLAYLISTS_PER_PAGE = PLAYLIST_COLS * PLAYLIST_ROWS;

void drawPlaylistPage();

bool fetchPlaylists()
{
  playlistsLoading = true;
  playlistsStatus = "Caricamento...";
  drawPlaylistPage();

  JsonDocument doc;
  JsonDocument filter;
  filter["items"][0]["name"] = true;
  filter["items"][0]["uri"] = true;

  int code = spotifyCall("GET", "/v1/me/playlists?limit=50&offset=0", &doc, &filter);
  playlistsLoading = false;
  spotifyPlaylists.clear();

  if (code == 200)
  {
    JsonArray items = doc["items"].as<JsonArray>();
    for (JsonObject item : items)
    {
      String name = fold(item["name"] | "");
      String uri = item["uri"] | "";
      if (!name.length() || !uri.length())
        continue;
      spotifyPlaylists.push_back({name, uri});
    }
    playlistsLoaded = true;
    playlistPage = 0;
    playlistsStatus = spotifyPlaylists.empty() ? "Nessuna playlist trovata" : "";
    return true;
  }

  playlistsLoaded = false;
  if (code == 403)
    playlistsStatus = "Ricollega Spotify";
  else if (code == 429)
    playlistsStatus = "Troppe richieste, riprova";
  else if (code < 0)
    playlistsStatus = "Errore di rete";
  else
    playlistsStatus = "Spotify HTTP " + String(code);
  return false;
}

constexpr int PL_X = 12, PL_Y = 52, PL_W = 148, PL_H = 40, PL_GX = 4, PL_GY = 5;

uint16_t monogramColor(const String &name)
{
  static const uint16_t P[] = {C_GREEN, C_CYAN, C_AMBER, C_VIOLET, C_PINK, C_BLUE};
  uint32_t h = 7;
  for (unsigned i = 0; i < name.length(); i++)
    h = h * 31 + (uint8_t)name[i];
  return P[h % 6];
}

void drawPlaylistPage()
{
  tft.fillScreen(C_BG);
  drawTopBar("PLAYLIST", C_GREEN);
  tft.setTextDatum(ML_DATUM);
  tft.setTextColor(C_FG);
  tft.drawString("Le tue playlist", 12, 40, 2);
  if (spotifyPlaylists.size())
  {
    tft.setTextColor(C_FAINT);
    tft.drawString(String((int)spotifyPlaylists.size()), 12 + tft.textWidth("Le tue playlist", 2) + 8, 40, 2);
  }
  // tasto aggiorna
  panel(282, 30, 26, 22, 8, C_PANEL2, C_LINE);
  drawRefreshIcon(295, 41, C_GREEN, C_PANEL2);
  if (playlistsLoading)
  {
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(C_DIM);
    tft.drawString("Caricamento playlist...", 160, 120, 2);
    tft.setTextDatum(TL_DATUM);
    return;
  }
  if (playlistsStatus.length())
  {
    tft.setTextDatum(MR_DATUM);
    tft.setTextColor(playlistsStatus == "In riproduzione" ? C_GREEN : C_RED);
    tft.drawString(playlistsStatus, 274, 40, 1);
  }
  tft.setTextDatum(TL_DATUM);
  if (spotifyPlaylists.empty())
  {
    panel(36, 84, 248, 76, 14);
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(C_FG, C_PANEL);
    tft.drawString("Nessuna playlist", 160, 108, 2);
    tft.setTextColor(C_GREEN, C_PANEL);
    tft.drawString("tocca l'icona in alto per aggiornare", 160, 134, 1);
    tft.setTextDatum(TL_DATUM);
    return;
  }
  int pagesCount = (spotifyPlaylists.size() + PLAYLISTS_PER_PAGE - 1) / PLAYLISTS_PER_PAGE;
  if (playlistPage >= pagesCount)
    playlistPage = pagesCount - 1;
  if (playlistPage < 0)
    playlistPage = 0;
  int first = playlistPage * PLAYLISTS_PER_PAGE;
  for (int slot = 0; slot < PLAYLISTS_PER_PAGE; slot++)
  {
    int idx = first + slot;
    if (idx >= (int)spotifyPlaylists.size())
      break;
    int x = PL_X + (slot % PLAYLIST_COLS) * (PL_W + PL_GX);
    int y = PL_Y + (slot / PLAYLIST_COLS) * (PL_H + PL_GY);
    const String &name = spotifyPlaylists[idx].name;
    uint16_t col = monogramColor(name);
    panel(x, y, PL_W, PL_H, 9);
    rrect(x + 6, y + 5, 30, 30, 8, mix565(C_PANEL, col, 235), C_PANEL);
    char ini[2] = {name.length() ? name[0] : '?', 0};
    if (ini[0] >= 'a' && ini[0] <= 'z')
      ini[0] -= 32;
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(C_BG, mix565(C_PANEL, col, 235));
    tft.drawString(ini, x + 21, y + 21, 4);
    auto lines = wrapText(name, 2, PL_W - 48);
    int n = min((int)lines.size(), 2);
    drawLines(lines, x + 42, y + (PL_H - n * 16) / 2, 2, 16, 2, C_FG, PL_W - 48);
  }
  // paginazione
  if (pagesCount > 1)
  {
    bool canPrev = playlistPage > 0, canNext = playlistPage + 1 < pagesCount;
    panel(12, 190, 44, 20, 10, canPrev ? C_PANEL2 : C_PANEL, C_LINE);
    drawChevron(34, 200, true, canPrev ? C_FG : C_FAINT, canPrev ? C_PANEL2 : C_PANEL);
    panel(264, 190, 44, 20, 10, canNext ? C_PANEL2 : C_PANEL, C_LINE);
    drawChevron(286, 200, false, canNext ? C_FG : C_FAINT, canNext ? C_PANEL2 : C_PANEL);
    int total = min(pagesCount, 8);
    int x0 = 160 - (total - 1) * 7;
    for (int i = 0; i < total; i++)
    {
      if (i == playlistPage)
        rrect(x0 + i * 14 - 5, 198, 10, 4, 2, C_GREEN);
      else
        disc(x0 + i * 14, 200, 2, C_LINE);
    }
  }
}
void playPlaylist(int idx)
{
  if (idx < 0 || idx >= (int)spotifyPlaylists.size())
    return;

  JsonDocument bodyDoc;
  bodyDoc["context_uri"] = spotifyPlaylists[idx].uri;
  String body;
  serializeJson(bodyDoc, body);

  playlistsStatus = "Avvio...";
  drawPlaylistPage();
  int code = spotifyCallJson("PUT", "/v1/me/player/play", body);
  if (code == 204)
  {
    playlistsStatus = "In riproduzione";
    nextPoll = 0;
  }
  else if (code == 404)
    playlistsStatus = "Nessun dispositivo attivo";
  else if (code == 403)
    playlistsStatus = "Serve Spotify Premium";
  else if (code == 429)
    playlistsStatus = "Troppe richieste, riprova";
  else if (code < 0)
    playlistsStatus = "Errore di rete";
  else
    playlistsStatus = "Spotify HTTP " + String(code);
  drawPlaylistPage();
}

void playlistEnter()
{
  drawPlaylistPage();
  if (!playlistsLoaded && !playlistsLoading)
  {
    fetchPlaylists();
    drawPlaylistPage();
  }
}

void playlistLoop() {}

void playlistTap(int x, int y)
{
  if (x >= 274 && y >= 26 && y <= 56)
  {
    fetchPlaylists();
    drawPlaylistPage();
    return;
  }
  if (spotifyPlaylists.empty())
    return;
  for (int slot = 0; slot < PLAYLISTS_PER_PAGE; slot++)
  {
    int cx = PL_X + (slot % PLAYLIST_COLS) * (PL_W + PL_GX);
    int cy = PL_Y + (slot / PLAYLIST_COLS) * (PL_H + PL_GY);
    if (x >= cx && x < cx + PL_W && y >= cy && y < cy + PL_H)
    {
      int idx = playlistPage * PLAYLISTS_PER_PAGE + slot;
      if (idx < (int)spotifyPlaylists.size())
        playPlaylist(idx);
      return;
    }
  }
  int pagesCount = (spotifyPlaylists.size() + PLAYLISTS_PER_PAGE - 1) / PLAYLISTS_PER_PAGE;
  if (y >= 186 && y < NAV_Y)
  {
    if (x < 90 && playlistPage > 0)
    {
      playlistPage--;
      drawPlaylistPage();
    }
    else if (x > 230 && playlistPage + 1 < pagesCount)
    {
      playlistPage++;
      drawPlaylistPage();
    }
  }
}
// ===================== Meteo =====================
struct Weather
{
  float t = 0, feels = 0, wind = 0;
  int hum = 0, code = 0, isDay = 1;
  float tmax[4] = {0}, tmin[4] = {0};
  int dcode[4] = {0}, wday[4] = {0};
} W;
bool weatherOk = false;
uint32_t weatherTs = 0, weatherTry = 0;

const char *DAYS_S[] = {"Dom", "Lun", "Mar", "Mer", "Gio", "Ven", "Sab"};
const char *DAYS_L[] = {"Domenica", "Lunedi", "Martedi", "Mercoledi", "Giovedi", "Venerdi", "Sabato"};
const char *MONTHS[] = {"Gennaio", "Febbraio", "Marzo", "Aprile", "Maggio", "Giugno", "Luglio",
                        "Agosto", "Settembre", "Ottobre", "Novembre", "Dicembre"};

bool fetchWeather()
{
  weatherTry = millis();
  String url = String("https://api.open-meteo.com/v1/forecast?latitude=") + WEATHER_LAT + "&longitude=" + WEATHER_LON +
               "&current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m,is_day"
               "&daily=weather_code,temperature_2m_max,temperature_2m_min&forecast_days=4&timezone=auto&wind_speed_unit=kmh";
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.useHTTP10(true);
  http.setTimeout(8000);
  if (!http.begin(client, url))
    return false;
  int code = http.GET();
  if (code != 200)
  {
    http.end();
    return false;
  }
  JsonDocument doc;
  DeserializationError e = deserializeJson(doc, http.getStream());
  http.end();
  if (e)
    return false;
  JsonObject c = doc["current"];
  W.t = c["temperature_2m"] | 0.0f;
  W.feels = c["apparent_temperature"] | 0.0f;
  W.hum = c["relative_humidity_2m"] | 0;
  W.code = c["weather_code"] | 0;
  W.wind = c["wind_speed_10m"] | 0.0f;
  W.isDay = c["is_day"] | 1;
  for (int i = 0; i < 4; i++)
  {
    W.dcode[i] = doc["daily"]["weather_code"][i] | 0;
    W.tmax[i] = doc["daily"]["temperature_2m_max"][i] | 0.0f;
    W.tmin[i] = doc["daily"]["temperature_2m_min"][i] | 0.0f;
    const char *d = doc["daily"]["time"][i] | "";
    int y = 0, m = 0, dd = 0;
    sscanf(d, "%d-%d-%d", &y, &m, &dd);
    struct tm tmv = {};
    tmv.tm_year = y - 1900;
    tmv.tm_mon = m - 1;
    tmv.tm_mday = dd;
    tmv.tm_hour = 12;
    mktime(&tmv);
    W.wday[i] = tmv.tm_wday;
  }
  weatherOk = true;
  weatherTs = millis();
  return true;
}

enum Kind
{
  K_CLEAR,
  K_PARTLY,
  K_CLOUDY,
  K_FOG,
  K_DRIZZLE,
  K_RAIN,
  K_SNOW,
  K_STORM
};

Kind kindOf(int c)
{
  if (c == 0)
    return K_CLEAR;
  if (c <= 2)
    return K_PARTLY;
  if (c == 3)
    return K_CLOUDY;
  if (c == 45 || c == 48)
    return K_FOG;
  if (c >= 51 && c <= 57)
    return K_DRIZZLE;
  if ((c >= 61 && c <= 67) || (c >= 80 && c <= 82))
    return K_RAIN;
  if ((c >= 71 && c <= 77) || c == 85 || c == 86)
    return K_SNOW;
  if (c >= 95)
    return K_STORM;
  return K_CLOUDY;
}

const char *descOf(int c)
{
  switch (c)
  {
  case 0:
    return "Sereno";
  case 1:
    return "Quasi sereno";
  case 2:
    return "Poco nuvoloso";
  case 3:
    return "Coperto";
  case 45:
  case 48:
    return "Nebbia";
  case 51:
  case 53:
  case 55:
  case 56:
  case 57:
    return "Pioviggine";
  case 61:
  case 63:
  case 65:
    return "Pioggia";
  case 66:
  case 67:
    return "Pioggia gelata";
  case 71:
  case 73:
  case 75:
  case 77:
    return "Neve";
  case 80:
  case 81:
  case 82:
    return "Rovesci";
  case 85:
  case 86:
    return "Rovesci di neve";
  case 95:
  case 96:
  case 99:
    return "Temporale";
  }
  return "--";
}

void drawCloud(int cx, int cy, int s, uint16_t col, uint16_t bg)
{
  int r = max(s / 5, 2);
  tft.fillSmoothCircle(cx - r * 3 / 2, cy + r / 2, r, col, bg);
  tft.fillSmoothCircle(cx + r * 3 / 2, cy + r / 2, r, col, bg);
  tft.fillSmoothCircle(cx - r / 4, cy - r / 3, r * 3 / 2, col, bg);
  tft.fillRect(cx - r * 3 / 2, cy + r / 2 - r / 3, r * 3 + 1, r + r / 3 + 1, col);
}

void drawSun(int cx, int cy, int r, uint16_t bg)
{
  for (int a = 0; a < 8; a++)
  {
    float rad = a * PI / 4;
    float c = cosf(rad), s = sinf(rad);
    tft.drawWideLine(cx + c * (r + 3), cy + s * (r + 3), cx + c * (r + 3 + r / 2 + 2), cy + s * (r + 3 + r / 2 + 2),
                     max(r / 5.0f, 1.6f), C_SUN, bg);
  }
  tft.fillSmoothCircle(cx, cy, r, C_SUN, bg);
}

void drawMoon(int cx, int cy, int r, uint16_t bg)
{
  tft.fillSmoothCircle(cx, cy, r, C565(240, 240, 205), bg);
  tft.fillSmoothCircle(cx + r / 2, cy - r / 3, r * 4 / 5, bg, C565(240, 240, 205));
}

void drawIcon(int cx, int cy, int s, int code, bool day, uint16_t bg = C_BG)
{
  Kind k = kindOf(code);
  int r = max(s / 5, 2);
  float lw = max(s / 22.0f, 1.6f);
  switch (k)
  {
  case K_CLEAR:
    if (day)
      drawSun(cx, cy, s / 4, bg);
    else
      drawMoon(cx, cy, s / 3, bg);
    break;
  case K_PARTLY:
    if (day)
      drawSun(cx - r, cy - r, r + r / 3, bg);
    else
      drawMoon(cx - r, cy - r, r + r / 2, bg);
    drawCloud(cx + r / 2, cy + r / 2, s * 4 / 5, C_CLOUD, bg);
    break;
  case K_CLOUDY:
    drawCloud(cx, cy, s, C_DARK, bg);
    break;
  case K_FOG:
    drawCloud(cx, cy - r / 2, s, C_CLOUD, bg);
    for (int i = 0; i < 3; i++)
      tft.drawWideLine(cx - r * 2 + (i % 2) * r / 2, cy + r * 2 + i * (r / 2 + 2), cx + r * 2 + (i % 2) * r / 2, cy + r * 2 + i * (r / 2 + 2), lw, C_DIM, bg);
    break;
  case K_DRIZZLE:
  case K_RAIN:
    drawCloud(cx, cy - r / 2, s, C_DARK, bg);
    for (int i = -1; i <= 1; i++)
    {
      int x = cx + i * r * 6 / 5;
      int n = (k == K_RAIN) ? 2 : 1;
      for (int j = 0; j < n; j++)
        tft.drawWideLine(x, cy + r * 2 + j * (r / 2 + 3), x - r / 3, cy + r * 3 + j * (r / 2 + 3), lw, C_RAIN, bg);
    }
    break;
  case K_SNOW:
    drawCloud(cx, cy - r / 2, s, C_CLOUD, bg);
    for (int i = -1; i <= 1; i++)
    {
      tft.fillSmoothCircle(cx + i * r * 6 / 5, cy + r * 2 + (i == 0 ? r / 2 : 0), max(r / 4, 1) + 1, C_FG, bg);
      tft.fillSmoothCircle(cx + i * r * 6 / 5 - 2, cy + r * 3 + (i == 0 ? 0 : r / 2), max(r / 4, 1), C_FG, bg);
    }
    break;
  case K_STORM:
    drawCloud(cx, cy - r / 2, s, C_DARK, bg);
    tft.fillTriangle(cx + r / 3, cy + r, cx - r / 2, cy + r * 2, cx, cy + r * 2, C_SUN);
    tft.fillTriangle(cx - r / 8, cy + r * 2, cx + r / 2, cy + r * 3 / 2 + r / 4, cx - r / 5, cy + r * 3 + r / 4, C_SUN);
    break;
  }
}

