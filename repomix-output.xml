}

void exitSpotifyAmbientMode()
{
  if (!spotifyAmbientMode)
    return;

  spotifyAmbientMode = false;
  updateRgbLed();
  lastUserInteractionMs = millis();
  switchPage(ambientReturnPage);
}

void spotifyAmbientLoop()
{
  static String lastAmbientTrackKey;
  static uint32_t lastAmbientProgress = 0;

  uint32_t now = millis();

  if (now >= nextPoll)
    spotifyPoll();

  if (!T.playing || !T.key.length())
  {
    lastAmbientTrackKey = "";
    exitSpotifyAmbientMode();
    return;
  }

  if (lastAmbientTrackKey != T.key)
  {
    lastAmbientTrackKey = T.key;
    drawSpotifyAmbientScreen();
    lastAmbientProgress = now;
    return;
  }

  if (now - lastAmbientProgress >= 500)
  {
    drawSpotifyAmbientProgress();
    lastAmbientProgress = now;
  }
}

