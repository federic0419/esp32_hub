}

void showColorCalibrationTest()
{
  tft.fillScreen(TFT_BLACK);

  const int cellW = 106;
  const int cellH = 70;

  struct TestColor
  {
    const char *name;
    uint8_t r;
    uint8_t g;
    uint8_t b;
  };

  const TestColor colors[9] = {
      {"ROSSO", 255, 0, 0},
      {"VERDE", 0, 255, 0},
      {"BLU", 0, 0, 255},

      {"GIALLO", 255, 255, 0},
      {"CIANO", 0, 255, 255},
      {"MAGENTA", 255, 0, 255},

      {"BIANCO", 255, 255, 255},
      {"GRIGIO", 128, 128, 128},
      {"NERO", 0, 0, 0}};

  tft.setTextDatum(MC_DATUM);

  for (int i = 0; i < 9; i++)
  {
    int col = i % 3;
    int row = i / 3;

    int x = col * cellW;
    int y = row * cellH;

    uint16_t c = testColor565(
        colors[i].r,
        colors[i].g,
        colors[i].b);

    tft.fillRect(x, y, cellW, cellH, c);

    // Scritta nera sui colori chiari, bianca sugli altri
    bool light =
        (colors[i].r + colors[i].g + colors[i].b) > 380;

    tft.setTextColor(light ? TFT_BLACK : TFT_WHITE);
    tft.drawString(
        colors[i].name,
        x + cellW / 2,
        y + cellH / 2,
        2);
  }

  tft.setTextDatum(TL_DATUM);
}

bool connectWiFi(const char *ssid, const char *password, uint32_t timeoutMs)
{
  WiFi.begin(ssid, password);

  uint32_t start = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - start < timeoutMs)
  {
    delay(100);
  }

  return WiFi.status() == WL_CONNECTED;
}

// ########==================== SETUP / LOOP PRINCIPALE ====================########
void setup()
{
  Serial.begin(115200);

  // LED RGB onboard: PWM per boot colorato e breathing Spotify Ambient.
  initRgbLed();

  // Display
  tft.init();
  tft.setRotation(ROTATION);
  tft.invertDisplay(DISPLAY_INVERT);
  tft.setSwapBytes(true);
  tft.fillScreen(C_BG);
  // showColorCalibrationTest();
  // delay(10000);
  // Breve intro animata.
  bootIntro();

  // Touch
  touchSPI.begin(TOUCH_CLK, TOUCH_MISO, TOUCH_MOSI, TOUCH_CS);
  ts.begin(touchSPI);
  ts.setRotation(ROTATION);

  // Preferences: calibrazione touch persistente + reset Spotify tenendo premuto lo schermo all'avvio.
  prefs.begin("cyddash", false);
  loadTouchCalibration();
  ambientSpotifyEnabled = prefs.getBool("amb_on", true);
  rgbLedEnabled = prefs.getBool("led_on", true);
  updateRgbLed();

  if (ts.tirqTouched() && ts.touched())
  {
    prefs.remove("rt");
    centerMsg("Account Spotify", "dimenticato, rilascia lo schermo");
    delay(2000);
  }
  refreshToken = prefs.getString("rt", "");

  // ---------------------------------------------------------
  // WiFi
  // ---------------------------------------------------------
  drawBootFrame(
      0.8f,
      0.15f,
      "connecting to " WIFI_SSID_1);

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID_1, WIFI_PASS_1, WIFI_CHANNEL);

  uint32_t wifiStart = millis();
  while (WiFi.status() != WL_CONNECTED &&
         millis() - wifiStart < 25000)
  {
    delay(100);
  }

  drawBootFrame(
      1.2f,
      0.30f,
      "WiFi connected");

  delay(180);

  // ---------------------------------------------------------
  // Ora / NTP
  // ---------------------------------------------------------
  drawBootFrame(
      1.6f,
      0.40f,
      "sync time");

  configTzTime(
      TZ_INFO,
      "pool.ntp.org",
      "time.google.com");

  struct tm ti;
  bool timeOk = getLocalTime(&ti, 10000);

  drawBootFrame(
      2.0f,
      0.50f,
      timeOk ? "time synced" : "time offline");

  delay(150);

  // ---------------------------------------------------------
  // Meteo
  // ---------------------------------------------------------
  drawBootFrame(
      2.4f,
      0.60f,
      "weather");

  bool bootWeatherOk = fetchWeather();

  drawBootFrame(
      2.8f,
      0.70f,
      bootWeatherOk ? "weather ready" : "weather offline");

  delay(160);

  // ---------------------------------------------------------
  // Spotify
  // ---------------------------------------------------------
  drawBootFrame(
      3.2f,
      0.80f,
      "spotify");

  initFilter();

#if REQUIRE_SPOTIFY_AUTH
  if (!refreshToken.length())
  {
    drawBootFrame(
        3.6f,
        0.85f,
        "Spotify login");

    delay(150);
    runAuthMode();
  }
#else
  Serial.println("Wokwi: autenticazione Spotify saltata");
#endif

  // ---------------------------------------------------------
  // Fine boot
  // ---------------------------------------------------------
  drawBootFrame(
      4.0f,
      1.0f,
      "ready");

  delay(300);

  switchPage(HOME_PAGE);
  lastUserInteractionMs = millis();
  updateRgbLed();
}

void loop()
{
  handleTouch();

  maybePollSpotifyBackground();

  if (spotifyAmbientMode)
  {
    spotifyAmbientLoop();
  }
  else
  {
    pages[curPage].loop();
    updateTopBarClock();
    maybeFetchWeather();
    maybeEnterSpotifyAmbientMode();
  }

  updateRgbLed();
  delay(2);
}
