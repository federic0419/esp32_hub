  struct tm now;
  bool timeOk = getLocalTime(&now, 0);
  int realYear = timeOk ? now.tm_year + 1900 : -1;
  int realMonth = timeOk ? now.tm_mon : -1;
  int realDay = timeOk ? now.tm_mday : -1;
  int rows = (firstDay + count + 6) / 7;
  for (int cell = 0; cell < rows * 7; cell++)
  {
    int col = cell % 7, row = cell / 7;
    int x = GRID_X + col * COL_W + COL_W / 2;
    int y = FIRST_ROW_Y + row * ROW_H;
    int day = cell - firstDay + 1;
    bool inMonth = day >= 1 && day <= count;
    if (day < 1)
      day = prevCount + day;
    else if (day > count)
      day -= count;
    bool today = inMonth && calendarYear == realYear && calendarMonth == realMonth && day == realDay;
    uint16_t txt;
    if (today)
    {
      disc(x, y, 11, C_VIOLET);
      txt = C_BG;
    }
    else if (!inMonth)
      txt = C565(58, 64, 82);
    else
      txt = col >= 5 ? mix565(C_DIM, C_VIOLET, 120) : C_FG;
    char d[4];
    snprintf(d, sizeof(d), "%d", day);
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(txt);
    tft.drawString(d, x, y, 2);
  }
  tft.setTextDatum(TL_DATUM);
}

void calendarEnter()
{
  struct tm ti;

  if (getLocalTime(&ti, 0))
  {
    calendarYear = ti.tm_year + 1900;
    calendarMonth = ti.tm_mon;
    calendarToday = ti.tm_mday;
  }

  drawCalendarPage();
}

void calendarLoop()
{
}

void calendarTap(int x, int y)
{
  if (y > 26 && y < 62)
  {
    if (x >= 236 && x < 275)
    {
      calendarMonth--;
      if (calendarMonth < 0)
      {
        calendarMonth = 11;
        calendarYear--;
      }
      drawCalendarPage();
    }
    else if (x >= 275)
    {
      calendarMonth++;
      if (calendarMonth > 11)
      {
        calendarMonth = 0;
        calendarYear++;
      }
      drawCalendarPage();
    }
    else if (x < 200)
    {
      // tocco sul titolo: torna al mese corrente
      calendarEnter();
    }
  }
}
// ===================== Gestione pagine =====================
struct Page
{
  void (*enter)();
  void (*loop)();
  void (*tap)(int, int);
};

const Page pages[] = {
    {playlistEnter, playlistLoop, playlistTap}, // 0
    {spEnter, spLoop, spTap},                   // 1
    {weatherEnter, weatherLoop, weatherTap},    // 2
    {clockEnter, clockLoop, clockTap},          // 3 HOME
    {radarEnter, radarLoop, radarTap},          // 4
    {f1Enter, f1Loop, f1Tap},                   // 5
    {calendarEnter, calendarLoop, calendarTap}  // 6 CALENDARIO
};
constexpr int NUM_PAGES = sizeof(pages) / sizeof(pages[0]);
constexpr int HOME_PAGE = 3;
int curPage = HOME_PAGE;

int pageTabX(int i)
{
  return (2 * i + 1) * 320 / (2 * NUM_PAGES);
}

void drawNavBar()
{
  uint16_t accent = pageAccent(curPage);
  tft.fillRect(0, NAV_Y, 320, NAV_H, C_NAV);
  tft.drawFastHLine(0, NAV_Y, 320, C_HAIR);
  for (int i = 0; i < NUM_PAGES; i++)
  {
    int cx = pageTabX(i);
    int cy = NAV_Y + 14;
    if (i == curPage)
    {
      rrect(cx - 17, NAV_Y + 3, 34, 21, 9, C_PANEL2, C_NAV);
      drawTabIcon(i, cx, cy, accent, C_PANEL2);
      rrect(cx - 7, NAV_Y, 14, 2, 1, accent, C_NAV);
    }
    else
      drawTabIcon(i, cx, cy, C_FAINT, C_NAV);
  }
}

void switchPage(int n)
{
  curPage = (n + NUM_PAGES) % NUM_PAGES;
  tft.setTextPadding(0);
  tft.setTextDatum(TL_DATUM);
  tft.setTextSize(1);
  pages[curPage].enter();
  drawNavBar();
}

// Aggiorna il meteo solo quando non si e' sulle pagine Spotify/Playlist.
void maybeFetchWeather()
{
  if (curPage == 0 || curPage == 1)
    return;
  uint32_t now = millis();
  bool stale = weatherOk && (now - weatherTs > WEATHER_REFRESH_MS);
  bool retry = !weatherOk && (weatherTry == 0 || now - weatherTry > 30000);
  if (stale || retry)
  {
    if (fetchWeather())
      switchPage(curPage);
  }
}

// Nessuna sospensione/screensaver automatica.
// Il display resta sulla pagina corrente finche l'utente non cambia pagina.

// ===================== Touch =====================
bool tsDown = false;
uint32_t tsLastSeen = 0, tsStartT = 0;
int sx, sy, lx, ly;

void handleTouch()
{
#ifdef WOKWI
  // Diagnostica Wokwi: ci serve capire se il click arriva davvero
  // all'XPT2046 simulato prima di modificare ancora la navigazione.
  static uint32_t lastTouchDebug = 0;

  bool irqActive = (digitalRead(TOUCH_IRQ) == LOW);
  bool touchedNow = ts.touched();
  bool now = touchedNow;

  uint32_t dbgNow = millis();
  if (dbgNow - lastTouchDebug >= 500)
  {
    Serial.printf("[WOKWI TOUCH] IRQ=%d touched=%d\n",
                  irqActive ? 1 : 0,
                  touchedNow ? 1 : 0);
    lastTouchDebug = dbgNow;
  }
#else
  bool now = ts.tirqTouched() && ts.touched();
#endif

  uint32_t ms = millis();

  if (now)
  {
    TS_Point p = ts.getPoint();

#ifdef WOKWI
    Serial.printf("[WOKWI TOUCH] RAW x=%d y=%d z=%d\n", p.x, p.y, p.z);
#endif

    int x = constrain(map(p.x, TS_MINX, TS_MAXX, 0, 319), 0, 319);
    int y = constrain(map(p.y, TS_MINY, TS_MAXY, 0, 239), 0, 239);

#ifdef WOKWI
    Serial.printf("[WOKWI TOUCH] MAP x=%d y=%d\n", x, y);
#endif
    if (!tsDown)
    {
      tsDown = true;
      sx = x;
      sy = y;
      tsStartT = ms;
    }
    lx = x;
    ly = y;
    tsLastSeen = ms;
  }
  else if (tsDown && ms - tsLastSeen > 60)
  {
    tsDown = false;
    int dx = lx - sx, dy = ly - sy;
    bool tap = abs(dx) < 20 && abs(dy) < 20 && ms - tsStartT < 800;

    if (tap && ly >= NAV_Y - 2)
    {
      // Tab bar: la colonna toccata decide la pagina.
      int best = constrain(lx * NUM_PAGES / 320, 0, NUM_PAGES - 1);
      if (best != curPage)
        switchPage(best);
    }
    else if (abs(dx) > 50 && abs(dx) > abs(dy) * 2)
    {
      switchPage(curPage + (dx < 0 ? 1 : -1));
    }
    else if (tap)
    {
      pages[curPage].tap(lx, ly);
    }
  }
}

// ===================== Boot animation =====================

static const uint16_t BOOT_DOTS[4] = {C_GREEN, C_CYAN, C_AMBER, C_RED};

void drawBootLogo(float phase)
{
  // marchio: quattro nodi (le sezioni dell'hub) attorno a un centro
  int active = ((int)(phase * 2.5f)) % 4;
  const int cx = 160, cy = 84;
  panel(cx - 34, cy - 34, 68, 68, 18, C_PANEL, C_LINE);
  static const int8_t ox[4] = {-15, 15, 15, -15}, oy[4] = {-15, -15, 15, 15};
  for (int i = 0; i < 4; i++)
  {
    uint16_t c = (i == active) ? BOOT_DOTS[i] : mix565(C_PANEL, BOOT_DOTS[i], 105);
    disc(cx + ox[i], cy + oy[i], (i == active) ? 8 : 7, c, C_PANEL);
  }
  disc(cx, cy, 4, C_FG, C_PANEL);
}


void drawBootProgress(float progress)
{
  progress = constrain(progress, 0.0f, 1.0f);
  constexpr int X = 80, Y = 196, W = 160, H = 4;
  rrect(X, Y, W, H, 2, C_TRACK);
  int fillW = (int)(W * progress);
  if (fillW > 0)
    rrect(X, Y, max(fillW, H), H, 2, C_GREEN, C_TRACK);
}

void drawBootFrame(
    float phase,
    float progress,
    const char *status = nullptr)
{
  if (!bootStatic)
  {
    tft.fillScreen(C_BG);
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(C_FG, C_BG);
    tft.drawString("CYD HUB", 160, 146, 4);
    tft.setTextColor(C_FAINT, C_BG);
    tft.drawString("v6", 160, 166, 1);
    bootStatic = true;
  }
  drawBootLogo(phase);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(C_DIM, C_BG);
  tft.setTextPadding(200);
  tft.drawString(status && strlen(status) ? status : "avvio...", 160, 182, 2);
  tft.setTextPadding(0);
  drawBootProgress(progress);
  tft.setTextDatum(TL_DATUM);
}

void bootIntro()
{
  bootStatic = false;
  for (int i = 0; i < 8; i++)
  {
    drawBootFrame(i * 0.4f, 0.05f + i * 0.02f, "avvio...");
    delay(90);
  }
}
// ===================== Test calibrazione colori =====================

uint16_t testColor565(uint8_t r, uint8_t g, uint8_t b)
{
  return C565(r, g, b);
}

void showColorCalibrationTest()
{
  tft.fillScreen(TFT_BLACK);

  const int cellW = 106;
  const int cellH = 70;

  struct TestColor
  {
    const char *name;
    uint8_t r;
    uint8_t g;
    uint8_t b;
  };

  const TestColor colors[9] = {
      {"ROSSO", 255, 0, 0},
      {"VERDE", 0, 255, 0},
      {"BLU", 0, 0, 255},

      {"GIALLO", 255, 255, 0},
      {"CIANO", 0, 255, 255},
      {"MAGENTA", 255, 0, 255},

      {"BIANCO", 255, 255, 255},
      {"GRIGIO", 128, 128, 128},
      {"NERO", 0, 0, 0}};

  tft.setTextDatum(MC_DATUM);

  for (int i = 0; i < 9; i++)
  {
    int col = i % 3;
    int row = i / 3;

    int x = col * cellW;
    int y = row * cellH;

    uint16_t c = testColor565(
        colors[i].r,
        colors[i].g,
        colors[i].b);

    tft.fillRect(x, y, cellW, cellH, c);

    // Scritta nera sui colori chiari, bianca sugli altri
    bool light =
        (colors[i].r + colors[i].g + colors[i].b) > 380;

    tft.setTextColor(light ? TFT_BLACK : TFT_WHITE);
    tft.drawString(
        colors[i].name,
        x + cellW / 2,
        y + cellH / 2,
        2);
  }

  tft.setTextDatum(TL_DATUM);
}

// ===================== Setup / loop =====================
void setup()
{
  Serial.begin(115200);

  // LED RGB della scheda spento (attivo basso)
  pinMode(4, OUTPUT);
  pinMode(16, OUTPUT);
  pinMode(17, OUTPUT);
  digitalWrite(4, HIGH);
  digitalWrite(16, HIGH);
  digitalWrite(17, HIGH);

  // Display
  tft.init();
  tft.setRotation(ROTATION);
  tft.invertDisplay(DISPLAY_INVERT);
  tft.setSwapBytes(true);
  tft.fillScreen(C_BG);
  // showColorCalibrationTest();
  // delay(10000);
  // Breve intro animata.
  bootIntro();

  // Touch
  touchSPI.begin(TOUCH_CLK, TOUCH_MISO, TOUCH_MOSI, TOUCH_CS);
  ts.begin(touchSPI);
  ts.setRotation(ROTATION);

  // Preferences / reset Spotify tenendo premuto lo schermo all'avvio.
  prefs.begin("cyddash", false);
  if (ts.tirqTouched() && ts.touched())
  {
    prefs.remove("rt");
    centerMsg("Account Spotify", "dimenticato, rilascia lo schermo");
    delay(2000);
  }
  refreshToken = prefs.getString("rt", "");

  // ---------------------------------------------------------
  // WiFi
  // ---------------------------------------------------------
  drawBootFrame(
      0.8f,
      0.15f,
      "connecting WiFi");

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASS, WIFI_CHANNEL);

  uint32_t wifiStart = millis();
  while (WiFi.status() != WL_CONNECTED &&
         millis() - wifiStart < 25000)
  {
    delay(100);
  }

  if (WiFi.status() != WL_CONNECTED)
  {
    centerMsg(
        "WiFi non riuscito",
        "controlla config.h - riavvio...",
        C_RED);

    delay(8000);
    ESP.restart();
  }

  drawBootFrame(
      1.2f,
      0.30f,
      "WiFi connected");

  delay(180);

  // ---------------------------------------------------------
  // Ora / NTP
  // ---------------------------------------------------------
  drawBootFrame(
      1.6f,
      0.40f,
      "sync time");

  configTzTime(
      TZ_INFO,
      "pool.ntp.org",
      "time.google.com");

  struct tm ti;
  bool timeOk = getLocalTime(&ti, 10000);

  drawBootFrame(
      2.0f,
      0.50f,
      timeOk ? "time synced" : "time offline");

  delay(150);

  // ---------------------------------------------------------
  // Meteo
  // ---------------------------------------------------------
  drawBootFrame(
      2.4f,
      0.60f,
      "weather");

  bool bootWeatherOk = fetchWeather();

  drawBootFrame(
      2.8f,
      0.70f,
      bootWeatherOk ? "weather ready" : "weather offline");

  delay(160);

  // ---------------------------------------------------------
  // Spotify
  // ---------------------------------------------------------
  drawBootFrame(
      3.2f,
      0.80f,
      "spotify");

  initFilter();

#if REQUIRE_SPOTIFY_AUTH
  if (!refreshToken.length())
  {
    drawBootFrame(
        3.6f,
        0.85f,
        "Spotify login");

    delay(150);
    runAuthMode();
  }
#else
  Serial.println("Wokwi: autenticazione Spotify saltata");
#endif

  // ---------------------------------------------------------
  // Fine boot
  // ---------------------------------------------------------
  drawBootFrame(
      4.0f,
      1.0f,
      "ready");

  delay(300);

  switchPage(HOME_PAGE);
}

void loop()
{
  handleTouch();

  pages[curPage].loop();

  updateTopBarClock();

  maybeFetchWeather();

  delay(2);
}
