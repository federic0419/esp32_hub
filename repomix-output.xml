// ===================== Calendario mensile =====================

int calendarYear = 0;
int calendarMonth = 0; // 0 = gennaio
int calendarToday = 0;

bool isLeapYear(int year)
{
  return (year % 400 == 0) || ((year % 4 == 0) && (year % 100 != 0));
}

int daysInMonth(int year, int month)
{
  static const int days[] = {
      31, 28, 31, 30, 31, 30,
      31, 31, 30, 31, 30, 31};

  if (month == 1 && isLeapYear(year))
    return 29;

  return days[month];
}

// Restituisce:
// 0 = lunedi
// 1 = martedi
// ...
// 6 = domenica
int firstWeekdayOfMonth(int year, int month)
{
  struct tm t = {};

  t.tm_year = year - 1900;
  t.tm_mon = month;
  t.tm_mday = 1;
  t.tm_hour = 12;

  mktime(&t);

  // tm_wday:
  // 0 = domenica ... 6 = sabato
  return (t.tm_wday + 6) % 7;
}

